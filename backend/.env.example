# Copy to .env (never commit .env).
# "production" (the default) turns off /api/docs and refuses to start unless COOKIE_SECURE=true and
# SECRET_KEY is a real secret. Local development: ENV=dev and COOKIE_SECURE=false (plain http).
ENV=dev
DATABASE_URL=sqlite:///./portfolio.db
# Postgres (uv sync --frozen --extra postgres). `postgres://` / `postgresql://` also work. Supabase:
#   session pooler (recommended on Render): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   direct (IPv6 only on the free plan):    postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   transaction pooler (port 6543):         ...pooler.supabase.com:6543/postgres?sslmode=require
#       -> also set DATABASE_PREPARE_THRESHOLD=none and SCHEDULER_LOCK_DATABASE_URL=<session pooler URL>
# DATABASE_PREPARE_THRESHOLD=5        # "none" disables prepared statements (transaction pooler)
# DB_POOL_SIZE=3                      # Postgres pool: at most size + overflow connections
# DB_MAX_OVERFLOW=2
# DB_POOL_PRE_PING=true
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_TIMEOUT_SECONDS=30
# Schema: true runs `alembic upgrade head` at startup (default in dev). Default false in production:
# run `python -m app.cli migrate` as a release step; the API refuses to start on an old schema.
# AUTO_MIGRATE=true
# Long random string (>= 32 chars); signs the session cookie. e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Default true. Set false only for plain-http local development.
COOKIE_SECURE=false
# Client IP behind the Cloudflare Pages Function proxy (docs/deployment.md). The Function sends the
# visitor's IP as X-Client-IP and a shared secret as X-Proxy-Auth (its env PROXY_SHARED_SECRET). The IP
# header is trusted ONLY when the secret matches; the app refuses to start with the header set and no
# secret. Off by default: a client can fake any header.
# TRUSTED_PROXY_HEADER=X-Client-IP
# PROXY_SHARED_SECRET=            # 16+ random characters, the same value as in the Pages project
# PROXY_AUTH_HEADER=X-Proxy-Auth
# Origin lock for production behind the Pages Function: when true, every /api request except
# /api/health and /api/telegram/webhook must carry X-Proxy-Auth = PROXY_SHARED_SECRET, else 404.
# The app refuses to start with this true and no secret. Default false.
# REQUIRE_PROXY_AUTH=false
# Universe screener inside the API process (heavy: set false in the 512 MB slim image, which does).
# SCHEDULER_UNIVERSE_ENABLED=true
# Tokens per UTC day per provider before it is skipped (0 = unlimited/unknown); JSON.
# LLM_DAILY_TOKEN_BUDGET={"gemini":0,"groq":180000}
# Seconds one committee run may take before the remaining roles use templates.
# COMMITTEE_DEADLINE_SECONDS=75
# Optionally only believe it when the TCP peer is inside these networks (JSON list).
# TRUSTED_PROXY_CIDRS=["10.0.0.0/8"]
# Host-provided client-IP header used when the proxy header is not trusted (Render sets
# CF-Connecting-IP; behind a private Caddy as in compose.prod.yml). Forgeable if the API is reachable directly.
# FALLBACK_IP_HEADER=CF-Connecting-IP
# Login backoff (per email+IP; the email-only limit is this many times higher; known devices are exempt).
# LOGIN_RATE_LIMIT_EMAIL_MULTIPLIER=20
# Cloudflare Turnstile on login after repeated failures for one email+IP. Unset TURNSTILE_ENABLED means
# off in dev and on in production when both keys are set. `python -m app.cli check-config` shows the state.
# TURNSTILE_ENABLED=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_AFTER_FAILURES=3          # failures of one email+IP pair
# TURNSTILE_EMAIL_AFTER_FAILURES=10   # failures of the email from any IP (a known device is exempt)
# Cloudflare echoes the widget's hostname and action: tokens minted elsewhere are refused. Empty hostnames =
# the hostnames of CORS_ORIGINS; the widget must send action "login" (TURNSTILE_EXPECTED_ACTION= disables it).
# TURNSTILE_ALLOWED_HOSTNAMES=[]
# TURNSTILE_EXPECTED_ACTION=login
# Rollback safety (docs/migrations.md): newer expand-only schema revisions an older build tolerates.
# DB_AHEAD_MAX_REVISIONS=1
# DB_ACCEPTED_AHEAD_REVISIONS=[]
# JSON list of allowed browser origins if the frontend is on another origin.
CORS_ORIGINS=[]

# Optional paid/keyed providers. Free defaults are used when these are empty.
GEMINI_API_KEY=
# Model ids are config. A startup probe checks that they exist for the key and falls back to the first
# available id in the *_MODEL_FALLBACKS list (it never blocks startup). Gemini 2.5 retires no earlier than 2026-10-16.
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL_FALLBACKS=["gemini-3.6-flash","gemini-2.5-flash-lite"]
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL_FALLBACKS=["openai/gpt-oss-120b","qwen/qwen3.8-27b"]
# MODEL_PROBE_ENABLED=true
TELEGRAM_BOT_TOKEN=
# Secret Telegram sends back in the X-Telegram-Bot-Api-Secret-Token header (setWebhook secret_token=).
# The webhook route POST /api/telegram/webhook refuses everything while this is empty.
TELEGRAM_WEBHOOK_SECRET=
# Bot username without @ (only used to build the t.me deep link)
TELEGRAM_BOT_USERNAME=
# Fallback price sources (block 2.1). Yahoo stays primary; a source with no key is simply off.
# Terms: "personal, non-commercial" free tiers; data stays behind login, no export or redistribution,
# footer credit "Data: Yahoo Finance, Finnhub, CoinGecko, ECB / Bank of Israel, TASE" as applicable.
# FINNHUB_API_KEY=                    # US live quote, free 60/min (no TASE)
# COINGECKO_API_KEY=                  # crypto, demo key (attribution required)
# FMP_API_KEY=                        # US daily history, free 250 calls/day
# STOOQ_API_KEY=                      # US last close + history (optional third source)
# USD/ILS falls back to Frankfurter (ECB) then Bank of Israel: no key. TASE has no free fallback:
# it keeps the last stored close, labelled with its date, and is never "fresh" through a fallback.
# QUOTE_FALLBACK_ENABLED=true
# QUOTE_FALLBACK_ORDER={"US":["finnhub","stooq"],"CRYPTO":["coingecko"],"TASE":[],"FX":["frankfurter","boi"]}
# HISTORY_FALLBACK_ORDER={"US":["fmp","stooq"],"CRYPTO":[],"TASE":[]}
# QUOTE_SOURCE_LIMITS={"finnhub":{"ttl_seconds":300,"max_calls_per_minute":50}}   # per-source TTL / budget / breaker
# QUOTE_DISAGREEMENT_PCT=5.0
# QUOTE_CROSSCHECK_MAX_SYMBOLS=10
# HISTORY_MISMATCH_TOLERANCE_PCT=2.0

# Tunables (all optional; defaults live in app/config.py)
# QUOTES_INTERVAL_MINUTES=5
# SIGNAL_WEIGHTS={"technical":25,"patterns":10,"fundamentals":20,"analysts":20,"geo_news":12.5,"sentiment":12.5}
# TASE_HOLIDAYS=["2026-10-03"]
# LOGIN_RATE_LIMIT_ATTEMPTS=5
# SIGNUP_RATE_LIMIT_PER_HOUR=10
# UPLOAD_RATE_LIMIT_PER_HOUR=30
# MAX_UPLOAD_BYTES=8388608
# MAX_ALERTS_PER_USER=50
# IMPORT_DRAFT_TTL_HOURS=24
# Scheduler inside the API process (single-host deployments). Only the instance holding the leader
# lock (Postgres advisory lock / SQLite lock file) runs the jobs; others just serve the API.
# SCHEDULER_IN_PROCESS=false
# SCHEDULER_LOCK_PATH=            # SQLite lock file (default: <database file>.scheduler.lock)
# SCHEDULER_LOCK_DATABASE_URL=    # Postgres URL for the lock when DATABASE_URL is a transaction pooler
# SCHEDULER_LEADER_CHECK_SECONDS=30
# SCHEDULER_MAX_WORKERS=1

# --- Phase 2.0-C: LLM foundation, horizon table, paper-trading gate ---
# LLM_ENABLED=true                  # false = always use the rule-based templates
# LLM_REQUESTS_PER_MINUTE=8         # per provider, shared across instances (stored in the database)
# LLM_PROVIDER_ORDER=gemini,groq
# LLM_USER_RPM=3 / LLM_ROLE_RPM=5   # per-minute sub-buckets, so one user or role cannot empty the provider bucket
# LLM_DAILY_BUDGET=900              # requests per provider per UTC day (free tiers are ~1,000)
# LLM_BATCH_DAILY_FRACTION=0.6      # background jobs may use this share; the rest is kept for on-demand questions
# LLM_USER_DAILY_BUDGET=60          # on-demand calls per user per day
# LLM_CACHE_TTL_NEWS_HOURS=6        # cache lifetime of answers whose prompt depends on news (default is 168 h)
# LLM_UNTRUSTED_MAX_CHARS=4000      # caps on fenced free text (news, user notes)
# LLM_UNTRUSTED_MAX_URLS=3
# GEMINI_THINKING_BUDGET=0          # thinking tokens count against the output cap; empty = the model's default
# YAHOO_CURRENCY_ALLOWED={".TA":["ILA","ILS"],"-USD":["USD"]}  # currencies Yahoo may report per symbol suffix
# LAUNCH_PAPER_MODEL_HASH=          # optional: only paper calls made with this model hash count for the gate
# GEMINI_MODEL=                     # model ids live in settings; see `python -m app.cli check-config --probe-models`
# GROQ_MODEL=
# GROQ_API_KEY=
# HORIZON_TABLE=                    # optional JSON override of the 1w/1m/3m/6m/1y exit-level table
# PRICE_FRESH_WINDOW_MINUTES=       # per-market freshness window for exit levels (US 60, TASE 60, CRYPTO 30)
# LAUNCH_PAPER_WINDOW_DAYS=30       # a paper call counts as resolved at 1 month after this many days
# BACKTEST_HISTORY_DIR=             # daily bars for the walk-forward backtest (default backend/data/history, git-ignored)
# BACKTEST_CAPITAL_ILS=100000       # starting cash of every simulated run
# BACKTEST_COMMISSION_BPS=10        # per side
# BACKTEST_SLIPPAGE_BPS=5           # per side, against us
# BACKTEST_SUCCESS_THRESHOLD=0.8    # held-out success rate every profile needs before --record is allowed
# BACKTEST_TARGETS=                 # optional JSON override of the PROPOSED per-preset return / drawdown bars
