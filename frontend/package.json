{
  "name": "portfolio-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_API_MOCK=1 next dev",
    "build": "npm run assets:ocr && next build && node scripts/finalize-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../backend/openapi.json -o lib/api-schema.d.ts",
    "assets:ocr": "node scripts/copy-ocr-assets.mjs --strict",
    "postinstall": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/heb": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
